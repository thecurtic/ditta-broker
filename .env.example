# Indexer naming — local inference endpoint. Copy to .env (gitignored) and
# point at your OpenAI-compatible server. No model name lives in the code.
BROKER_NAMING_ENDPOINT=http://127.0.0.1:8080/v1
BROKER_NAMING_MODEL=your-local-model-id
# BROKER_NAMING_API_KEY=            # usually empty for a local server
